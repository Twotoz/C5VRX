# Guarded ESP32-C5 native RF/IQ ring acceptance image for XIAO ESP32-C5.
# This is a complete profile. It deliberately disables autonomous A1 AV so
# the experimental controller is only touched by an explicit bounded command.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_xiao_receiver_console.csv"
CONFIG_C5VRX_BOARD_PROFILE="xiao-esp32c5-native-ring-probe"

CONFIG_C5VRX_RF_BACKEND_WIFI5=y
CONFIG_C5VRX_TARGET_BAND_A=y
CONFIG_C5VRX_TARGET_CHANNEL=1
CONFIG_C5VRX_RX_HT40=y
CONFIG_C5VRX_EXPERIMENTAL_RF_DUMP_PRODUCER=y
CONFIG_C5VRX_EXPERIMENTAL_NATIVE_RING_PROBE=y
CONFIG_C5VRX_NATIVE_A1_AV=y
# CONFIG_C5VRX_AUTO_A1_AV is not set

CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=8192
CONFIG_RTC_FAST_CLK_SRC_XTAL=y

# The bounded acceptance command parks the HP core while the MAC owns the
# dump SRAM. It always has a duration/timeout and restores ownership on exit.
# CONFIG_ESP_INT_WDT is not set

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
# CONFIG_C5VRX_EXPERIMENTAL_DIRECT_TUNE is not set
# CONFIG_C5VRX_EXPERIMENTAL_ADC_DUMP is not set

# Preserve the PR21 PAL fallback/output wiring. Native-ring AV integration is
# intentionally absent until physical OFF/ON/TONE acceptance proves the ring.
CONFIG_C5VRX_EXPERIMENTAL_CVBS_PARLIO=y
CONFIG_C5VRX_CVBS_DAC_BITS=6
CONFIG_C5VRX_CVBS_D0_GPIO=23
CONFIG_C5VRX_CVBS_D1_GPIO=24
CONFIG_C5VRX_CVBS_D2_GPIO=11
CONFIG_C5VRX_CVBS_D3_GPIO=12
CONFIG_C5VRX_CVBS_D4_GPIO=8
CONFIG_C5VRX_CVBS_D5_GPIO=9
CONFIG_C5VRX_CVBS_D6_GPIO=-1
CONFIG_C5VRX_CVBS_D7_GPIO=-1

CONFIG_C5VRX_STATUS_LED_GPIO=27
CONFIG_C5VRX_STATUS_LED_ACTIVE_LOW=y
