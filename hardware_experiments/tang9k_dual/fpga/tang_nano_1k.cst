// C5VRX by Twotoz and the C5VRX contributors: hardware experiment
// TANG9K_DUAL on a Sipeed Tang Nano 1K (GW1NZ-LV1QN48), DAC output (top_1k).
// All pins bank 0/1, 3.3 V: no divider for C5 B. The 40-pin LCD is not
// used (its pins carry C5 A and the DAC); pins 9-11 (RGB LED) and 13 (key
// A, do not press) carry C5 B. Pins 45/46 (READY/DONE) and 44 (JTAGSEL_N)
// are left free. C5 side as ../hwx.h.
IO_LOC "clk_a" 27;
IO_PORT "clk_a" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_a[0]" 28;
IO_PORT "iq_a[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_a[1]" 24;
IO_PORT "iq_a[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_a[2]" 23;
IO_PORT "iq_a[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_a[3]" 22;
IO_PORT "iq_a[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_a[4]" 18;
IO_PORT "iq_a[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_a[5]" 17;
IO_PORT "iq_a[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_a[6]" 16;
IO_PORT "iq_a[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_a[7]" 15;
IO_PORT "iq_a[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "clk_b" 35;
IO_PORT "clk_b" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_b[0]" 40;
IO_PORT "iq_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_b[1]" 41;
IO_PORT "iq_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_b[2]" 38;
IO_PORT "iq_b[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_b[3]" 39;
IO_PORT "iq_b[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_b[4]" 42;
IO_PORT "iq_b[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_b[5]" 13;
IO_PORT "iq_b[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_b[6]" 9;
IO_PORT "iq_b[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "iq_b[7]" 10;
IO_PORT "iq_b[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "dac[0]" 29;
IO_PORT "dac[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "dac[1]" 30;
IO_PORT "dac[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "dac[2]" 31;
IO_PORT "dac[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "dac[3]" 19;
IO_PORT "dac[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "dac[4]" 20;
IO_PORT "dac[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "dac[5]" 34;
IO_PORT "dac[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
