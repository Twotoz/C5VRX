CONFIG_IDF_TARGET="esp32c5"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHFREQ="40m"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160
CONFIG_C5VRX2_MODE_PARLIO4_80M_ORACLE=y
# CONFIG_C5VRX2_MODE_LIVE is not set
# CONFIG_C5VRX2_WBFM_PHASE5_100NS is not set
# CONFIG_C5VRX2_WBFM_PHASE5_QUALITY is not set
# CONFIG_C5VRX2_WBFM_TRUE40 is not set
# CONFIG_C5VRX2_WBFM_TRAJECTORY is not set
# CONFIG_C5VRX2_LINEAR80 is not set
# CONFIG_C5VRX2_PARLIO_RX_NEG_EDGE is not set
# CONFIG_C5VRX2_ISSUE11_CAPTURE is not set
# CONFIG_C5VRX2_LIVE_SNAPSHOT_ONCE is not set
# CONFIG_C5VRX2_WBFM_SELFTEST_ONCE is not set
