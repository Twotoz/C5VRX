# Two-bundle steady-state Phase5 WBFM core.
# Full Q4/I4 (8-bit Cartesian) input at 40 MS/s.
# 20 MS/s unique 6-bit CVBS output, duplicated as [D,D] at 40 MHz DAC clock.
#
# Two instructions total; the first two output pairs establish the pipeline
# state after prefetch. Their DAC values are startup-only and untrusted.
#   address_delta  - steady-state bundle 1
#   emit           - steady-state bundle 2 (loops back to address_delta)
#
# LUT layout (dual-purpose 16-bit words):
#   LUT[packed_q4i4].bits[12:8]          = 5-bit Phase5 state (uniform polar bins)
#   LUT[(prev_phase5<<5)|curr_phase5]    = 6-bit DAC code (centroid delta, P20/G2)
#
# O26..O30 holds the previous Phase5 state across ALL ring/DMA boundaries.
# cfg eof_on downstream + cfg trailing_bytes 0 ensures PARLIO TX loop_transmission
# never generates a downstream EOF, so the BitScrambler runs uninterrupted forever.
#
# Reference: Seamless Golden 16K (build-golden-notel) -- proven best live build.
# P20 pedestal, G2 gain, current-minus-previous polarity.

cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16

# Embedded 1044-entry LUT. Hardware oracle v9 proved embedded LUT data is
# byte-exact at 20 MS/s; a separately preloaded LUT is NOT retained by the
# active PARLIO TX run on ESP32-C5 / IDF 6.0.x.
lut 5124 6662 7943 9735 11271 12808 14600 15880 16152 15384 12312 9241 5145 5145 5146 5148 5122 5124 5125 5126 5126 4615 3591 2055 25 25 25 26 26 795 2332 3614 3585 5123 6404 8197 9733 11270 13062 14342 15898 16154 15386 12315 9243 5148 5149 5151 5121 5122 5123 5124 5125 5125 4613 3590 2074 27 27 27 28 29 798 2079 2305 3842 5123 6915 8452 9989 11781 13061 14619 16155 16155 15388 12317 9245 5150 5151 5120 5121 5122 5123 5123 5124 5124 4613 3611 2076 28 28 29 30 31 768 512 2049 3330 5123 6659 8196 9988 11268 12828 14364 15644 16157 15389 12318 9247 5120 5120 5121 5122 5122 5123 5123 5124 5124 4636 3612 2077 29 30 30 31 0 16 527 1806 3598 5133 6669 8460 9740 11284 12820 14099 15635 16146 15378 12305 9232 5136 5135 5134 5133 5133 5132 5132 5132 5140 4628 3604 2067 19 18 17 16 16 15 270 2061 3597 5132 6924 8203 9749 11284 12564 14099 15891 16146 15377 12304 9231 5134 5133 5133 5132 5132 5131 5131 5141 5141 4629 3604 2067 19 18 17 15 14 13 268 1803 3339 5131 6410 7958 9493 11029 12565 14100 15635 16146 15377 12303 9229 5132 5131 5131 5130 5130 5130 5142 5142 5142 4629 3605 2068 19 17 14 12 11 10 522 2057 3849 5129 6679 8215 9495 11030 12822 14357 16148 16146 15372 12298 9225 5129 5129 5128 5128 5128 5144 5144 5144 5143 4631 3607 2070 20 0 0 0 0 0 514 2313 3598 5140 6682 7967 9509 11308 12850 14649 15934 16191 15420 12336 9252 5140 5140 5140 5140 5140 5140 5140 5140 5140 4626 3598 2056 2056 0 0 0 0 0 771 2056 3598 5140 6425 7967 9766 11308 13107 14392 15934 16191 15420 12336 9252 5140 5140 5140 5140 5183 5183 5183 5183 5183 4626 3598 3598 2056 0 0 0 0 0 771 2313 3855 5140 6682 8481 10023 11822 13107 14649 16191 16191 15420 12336 9252 5140 5140 5140 5140 5183 5183 5183 5183 5183 4626 4626 3598 2056 0 0 0 0 0 771 2313 3598 5140 6939 8481 10280 11565 13107 14649 15934 16191 15420 12336 9252 5140 5140 5140 5140 5183 5183 5183 5183 5183 5140 4626 3598 2056 0 0 0 0 0 514 1799 3341 5140 6682 8481 9766 11308 12850 14135 15934 16191 15420 12336 9252 5140 5140 5140 5140 5183 5183 5183 5183 5140 5140 4626 3598 2056 0 0 0 0 0 257 1799 3598 5140 6939 8224 9766 11308 12593 14392 15934 16191 15420 12336 9252 5140 5140 5140 5140 5183 5183 5183 5140 5140 5140 4626 3598 2056 0 0 0 0 0 0 1799 3341 5140 6425 7967 9509 11051 12593 14135 15677 16191 15420 12336 9252 5140 5140 5140 5140 5183 5183 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 514 2056 3855 5140 6682 8224 9509 11308 12850 14392 16191 16191 15420 12336 9252 5140 5140 5140 5140 5183 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 514 2313 3598 5140 6682 7967 9766 11308 12850 14649 15934 16191 15420 12336 9252 5140 5140 5140 5140 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 771 2056 3598 5140 6425 8224 9766 11308 13107 14392 15934 16191 15420 12336 9252 5140 5140 5140 5120 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 771 2313 3855 5140 6939 8481 10023 11822 13107 14649 16191 16191 15420 12336 9252 5140 5140 5120 5120 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 514 2056 3341 5140 6682 8224 10023 11308 12850 14392 15677 16191 15420 12336 9252 5140 5120 5120 5120 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 514 1799 3598 5140 6682 8481 9766 11308 12850 14135 15934 16191 15420 12336 9252 9252 5120 5120 5120 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 257 2056 3598 5140 6939 8224 9766 11308 12593 14392 15934 16191 15420 12336 12336 9252 5120 5120 5120 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 257 1799 3341 5140 6425 7967 9509 11051 12593 14135 15934 16191 15420 15420 12336 9252 5120 5120 5120 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 514 2056 3855 5140 6682 8224 9509 11308 12850 14649 16191 16191 16191 15420 12336 9252 5120 5120 5120 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 514 2313 3598 5140 6682 7967 9766 11308 13107 14649 15934 15934 16191 15420 12336 9252 5140 5140 5140 5120 5140 5140 5140 5140 5140 4626 3598 2056 0 0 0 0 0 771 2056 3598 5140 6425 8224 9766 11565 13107 14392 14649 16191 16191 15420 12336