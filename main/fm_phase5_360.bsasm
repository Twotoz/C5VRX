# Two-bundle steady-state Phase5 WBFM core.
# Full Q4/I4 (8-bit Cartesian) input at 40 MS/s.
# 20 MS/s unique 6-bit CVBS output, duplicated as [D,D] at 40 MHz DAC clock.
#
# Two instructions total; the first two output pairs establish the pipeline
# state after prefetch. Their DAC values are startup-only and untrusted.
#   address_delta  - steady-state bundle 1
#   emit           - steady-state bundle 2 (loops back to address_delta)
#
# LUT layout (dual-purpose 16-bit words):
#   LUT[packed_q4i4].bits[12:8]          = 5-bit Phase5 state (uniform polar bins)
#   LUT[(prev_phase5<<5)|curr_phase5]    = 6-bit DAC code (centroid delta, P20/G2)
#
# O26..O30 holds the previous Phase5 state across ALL ring/DMA boundaries.
# cfg eof_on downstream + cfg trailing_bytes 0 ensures PARLIO TX loop_transmission
# never generates a downstream EOF, so the BitScrambler runs uninterrupted forever.
#
# Reference: Seamless Golden 16K (build-golden-notel) -- proven best live build.
# P20 pedestal, G2 gain, current-minus-previous polarity.

cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16

# Embedded 1044-entry LUT. Hardware oracle v9 proved embedded LUT data is
# byte-exact at 20 MS/s; a separately preloaded LUT is NOT retained by the
# active PARLIO TX run on ESP32-C5 / IDF 6.0.x.
lut 5124 6662 7943 9735 11271 12808 14600 15880 16152 15384 12312 9241 25 25 26 28 16130 16132 16133 16134 16134 4615 3591 2055 25 25 25 26 26 795 2332 3614 3585 5123 6404 8197 9733 11270 13062 14342 15898 16154 15386 12315 9243 28 29 31 1 16130 16131 16132 16133 16133 4613 3590 2074 27 27 27 28 29 798 2079 2305 3842 5123 6915 8452 9989 11781 13061 14619 16155 16155 15388 12317 9245 30 31 0 1 16130 16131 16131 16132 16132 4613 3611 2076 28 28 29 30 31 768 512 2049 3330 5123 6659 8196 9988 11268 12828 14364 15644 16157 15389 12318 9247 0 0 1 2 16130 16131 16131 16132 16132 4636 3612 2077 29 30 30 31 0 16 527 1806 3598 5133 6669 8460 9740 11284 12820 14099 15635 16146 15378 12305 9232 16 15 14 13 16141 16140 16140 16140 16148 4628 3604 2067 19 18 17 16 16 15 270 2061 3597 5132 6924 8203 9749 11284 12564 14099 15891 16146 15377 12304 9231 14 13 13 12 16140 16139 16139 16149 16149 4629 3604 2067 19 18 17 15 14 13 268 1803 3339 5131 6410 7958 9493 11029 12565 14100 15635 16146 15377 12303 9229 12 11 11 10 16138 16138 16150 16150 16150 4629 3605 2068 19 17 14 12 11 10 522 2057 3849 5129 6679 8215 9495 11030 12822 14357 16148 16146 15372 12298 9225 9 9 8 8 16136 16152 16152 16152 16151 4631 3607 2070 20 4 6 7 7 7 520 2312 3592 5144 6680 7960 9497 11289 12825 14618 15900 16130 15364 12293 9222 6 7 7 7 16153 16153 16153 16154 16154 4635 3612 2078 2049 3 4 5 5 6 774 2054 3610 5146 6426 7963 9755 11292 13085 14367 15873 16130 15363 12292 9221 5 5 6 26 16155 16155 16155 16156 16157 4638 3615 3585 2050 3 3 4 5 5 773 2331 3867 5147 6684 8477 10013 11806 13087 14592 16129 16130 15363 12291 9220 4 5 27 28 16156 16156 16157 16158 16159 4608 4608 3585 2050 3 3 4 4 4 796 2332 3612 5149 6941 8478 10271 11520 13056 14593 15874 16130 15363 12291 9220 4 28 28 29 16157 16158 16158 16159 16128 16144 4623 3598 2062 13 13 12 12 20 532 1811 3347 5138 6674 8465 9744 11280 12815 14094 15885 16141 15372 12300 9228 20 20 20 19 16147 16146 16145 16144 16144 16143 4622 3597 2061 12 12 11 21 20 276 1811 3603 5138 6929 8208 9743 11278 12557 14349 15884 16140 15371 12299 9237 21 21 20 19 16147 16146 16145 16143 16142 16141 4620 3595 2059 11 10 22 21 21 21 1812 3347 5138 6417 7951 9485 11020 12555 14091 15626 16138 15370 12310 9238 22 21 21 20 16147 16145 16142 16140 16139 16138 4618 3593 2057 9 23 23 23 22 534 2069 3860 5138 6668 8202 9481 11273 12809 14344 16136 16136 15384 12312 9240 23 23 23 22 16148 16132 16134 16135 16135 16135 4616 3592 2056 24 24 24 25 25 537 2330 3612 5122 6660 7941 9734 11270 12807 14599 15879 16153 15385 12313 9242 26 27 28 30 1 16131 16132 16133 16133 16134 4614 3590 2074 26 26 27 27 28 797 2079 3585 5122 6403 8196 9733 11269 13061 14342 15898 16155 15387 12315 9244 29 30 31 1 2 16131 16131 16132 16133 16133 4613 3611 2075 27 28 29 29 30 799 2304 3841 5122 6915 8451 9988 11780 13061 14619 16156 16156 15388 12317 9246 31 0 0 1 2 16131 16131 16132 16132 16132 4636 3612 2076 29 29 30 31 0 512 2049 3330 5122 6659 8195 9988 11268 12828 14364 15645 16157 15390 12318 9247 0 16 15 14 14 16141 16141 16140 16140 16148 4628 3603 2067 18 18 17 16 16 527 1806 3597 5133 6668 8460 9740 11284 12820 14100 15891 16147 15378 12305 9232 9232 15 14 13 13 16140 16140 16139 16149 16148 4628 3603 2067 18 17 16 15 14 269 2061 3596 5132 6923 8203 9749 11285 12565 14356 15891 16147 15378 12305 12303 9230 13 12 11 11 16139 16138 16150 16149 16149 4629 3604 2067 18 17 15 13 12 267 1803 3338 5130 6410 7958 9494 11030 12565 14101 15892 16147 15377 15374 12300 9227 10 10 9 9 16137 16151 16151 16151 16150 4630 3605 2068 18 12 10 9 9 521 2056 3848 5128 6680 8216 9496 11287 12823 14615 16150 16148 16132 15366 12295 9223 7 8 8 8 16152 16152 16152 16153 16153 4633 3610 2076 2 4 5 6 6 519 2311 3591 5145 6681 7961 9754 11290 13083 14620 15902 15873 16131 15364 12293 9221 6 6 6 26 16154 16154 16155 16155 16156 4637 3615 2049 2 3 4 5 5 773 2054 3610 5147 6427 8219 9756 11549 13086 14367 14593 16130 16131 15363 12292 9221 5 5 27 27 16155 16156 16157 16157 16158 4639 3584 2049 2 3 3 4 4 773 2331 3868 5148 6940 8477 10270 11807 13056 12800 14337 15618 16131 15363 12292 9220 4 28 28 28 16157 16157 16158 16159 16128 4608 3585 2050 2 3 3 4 4 540 2076 3357 5149 6686 8478 10015 11264 11280 12815 14094 15886 16141 15373 12300 9228 20 20 19 19 16146 16146 16145 16144 16144 4623 3598 2061 13 12 12 12 20 532 1812 3603 5139 6930 8465 9744 9488 11023 12558 14093 15629 16140 15372 12299 9237 20 20 19 19 16146 16145 16144 16143 16142 4621 3597 2060 12 11 11 21 21 21 1812 3347 5139 6674 7953 7951 9486 11021 12556 14091 15627 16139 15370 12310 9237 21 21 20 19 16146 16145 16143 16141 16140 4619 3595 2058 10 10 22 22 22 277 1813 3604 5139 6417 6670 8204 9483 11274 12810 14345 16137 16137 15383 12311 9239 22 22 21 20 16146 16140 16138 16137 16137 4617 3592 2056 8 24 24 24 23 535 2327 3862 5140

controller_0:
    set 26..30 L0..L4,
    set 16..20 L0..L4,
    set 21..25 O26..O30,
    set 31 L,
    if 7 worker_360

worker_golden:
    set 0..5 L8..L13,
    set 6..7 L,
    set 8..13 L8..L13,
    set 14..15 L,
    set 16..23 8..15,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 16,
    write 16,
    jmp controller_0

worker_360:
    set 0..5 L8..L13,
    set 6..7 L,
    set 8..13 L8..L13,
    set 14..15 L,
    set 16..23 8..15,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 16,
    write 16,
    jmp controller_0
