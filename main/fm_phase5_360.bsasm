controller_0:
    set 26..30 L0..L4,
    set 16..20 L0..L4,
    set 21..25 O26..O30,
    set 31 L,
    if 7 worker_360

worker_golden:
    set 0..5 L8..L13,
    set 6..7 L,
    set 8..13 L8..L13,
    set 14..15 L,
    set 26..30 O26..O30,
    set 16..23 8..15,
    set 24..31 0..7,
    ldctib,
    read 16,
    write 16,
    jmp controller_0

worker_360:
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 26..30 O26..O30,
    set 16..23 8..15,
    set 24..31 0..7,
    ldctib,
    read 16,
    write 16,
    jmp controller_0
