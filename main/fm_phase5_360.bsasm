# Two-bundle steady-state Phase5 WBFM core.
# Full Q4/I4 (8-bit Cartesian) input at 40 MS/s.
# 20 MS/s unique 6-bit CVBS output, duplicated as [D,D] at 40 MHz DAC clock.
#
# Two instructions total; the first two output pairs establish the pipeline
# state after prefetch. Their DAC values are startup-only and untrusted.
#   address_delta  - steady-state bundle 1
#   emit           - steady-state bundle 2 (loops back to address_delta)
#
# LUT layout (dual-purpose 16-bit words):
#   LUT[packed_q4i4].bits[12:8]          = 5-bit Phase5 state (uniform polar bins)
#   LUT[(prev_phase5<<5)|curr_phase5]    = 6-bit DAC code (centroid delta, P20/G2)
#
# O26..O30 holds the previous Phase5 state across ALL ring/DMA boundaries.
# cfg eof_on downstream + cfg trailing_bytes 0 ensures PARLIO TX loop_transmission
# never generates a downstream EOF, so the BitScrambler runs uninterrupted forever.
#
# Reference: Seamless Golden 16K (build-golden-notel) -- proven best live build.
# P20 pedestal, G2 gain, current-minus-previous polarity.

cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16

# Embedded 1044-entry LUT. Hardware oracle v9 proved embedded LUT data is
# byte-exact at 20 MS/s; a separately preloaded LUT is NOT retained by the
# active PARLIO TX run on ESP32-C5 / IDF 6.0.x.
lut 5124 6662 7943 9735 11271 12552 11784 9736 5144 5144 5144 5145 5145 5145 5146 5148 5122 5124 5125 5126 5126 5127 5127 5127 5145 4121 3097 1562 26 795 2332 3614 3585 5123 6404 8197 9733 11270 12550 11782 9754 5146 5146 5147 5147 5148 5149 5151 5121 5122 5123 5124 5125 5125 5125 5126 5146 5147 4123 3099 1564 29 798 2079 2305 3842 5123 6915 8452 9989 11781 12549 11803 9755 5147 5148 5149 5149 5150 5151 5120 5121 5122 5123 5123 5124 5124 5125 5147 5148 5148 4124 3101 1566 31 768 512 2049 3330 5123 6659 8196 9988 11268 12572 11804 9756 5149 5149 5150 5151 5120 5120 5121 5122 5122 5123 5123 5124 5124 5148 5148 5149 5149 4126 3102 1567 0 16 527 1806 3598 5133 6669 8460 9740 11284 12564 11795 9747 5138 5138 5137 5136 5136 5135 5134 5133 5133 5132 5132 5132 5140 5140 5140 5139 5139 4114 3089 1552 1552 15 270 2061 3597 5132 6924 8203 9749 11284 12564 11795 9747 5138 5137 5136 5135 5134 5133 5133 5132 5132 5131 5131 5141 5141 5141 5140 5139 5139 4114 3089 3087 1550 13 268 1803 3339 5131 6410 7958 9493 11029 12565 11796 9747 5138 5137 5135 5133 5132 5131 5131 5130 5130 5130 5142 5142 5142 5141 5141 5140 5139 4113 4110 3084 1547 10 522 2057 3849 5129 6679 8215 9495 11030 12566 11797 9748 5138 5132 5130 5129 5129 5129 5128 5128 5128 5144 5144 5144 5143 5143 5143 5142 5140 5124 4102 3079 1543 7 520 2312 3592 5144 6680 7960 9497 11289 12569 11802 9756 5122 5124 5125 5126 5126 5127 5127 5127 5145 5145 5145 5146 5146 5147 5148 5150 5121 5123 4100 3077 1541 6 774 2054 3610 5146 6426 7963 9755 11292 12573 11807 9729 5122 5123 5124 5125 5125 5125 5126 5146 5147 5147 5147 5148 5149 5150 5151 5121 5122 5123 4099 3076 1541 5 773 2331 3867 5147 6684 8477 10013 11806 12575 11776 9729 5122 5123 5123 5124 5124 5125 5147 5148 5148 5148 5149 5150 5151 5120 5120 5121 5122 5123 4099 3076 1540 4 796 2332 3612 5149 6941 8478 10271 11520 12544 11777 9730 5122 5123 5123 5124 5124 5148 5148 5149 5149 5150 5150 5151 5120 5136 5135 5134 5134 5133 4109 3084 1548 20 532 1811 3347 5138 6674 8465 9744 11280 12559 11790 9741 5133 5132 5132 5132 5140 5140 5140 5139 5139 5138 5137 5136 5136 5135 5134 5133 5133 5132 4108 3083 1557 20 276 1811 3603 5138 6929 8208 9743 11278 12557 11789 9740 5132 5131 5131 5141 5141 5141 5140 5139 5139 5138 5137 5135 5134 5133 5132 5131 5131 5131 4106 3094 1557 21 21 1812 3347 5138 6417 7951 9485 11020 12555 11787 9738 5130 5130 5142 5142 5142 5141 5141 5140 5139 5137 5134 5132 5131 5130 5130 5129 5129 5129 4119 3095 1559 22 534 2069 3860 5138 6668 8202 9481 11273 12553 11784 9736 5128 5144 5144 5144 5143 5143 5143 5142 5140 5124 5126 5127 5127 5127 5128 5128 5128 5144 4120 3096 1561 25 537 2330 3612 5122 6660 7941 9734 11270 12551 11783 9735 5145 5145 5145 5146 5146 5147 5148 5150 5121 5123 5124 5125 5125 5126 5126 5126 5146 5146 4122 3099 1563 28 797 2079 3585 5122 6403 8196 9733 11269 12549 11782 9754 5147 5147 5147 5148 5149 5150 5151 5121 5122 5123 5123 5124 5125 5125 5125 5147 5147 5147 4124 3101 1565 30 799 2304 3841 5122 6915 8451 9988 11780 12549 11803 9756 5148 5148 5149 5150 5151 5120 5120 5121 5122 5123 5123 5124 5124 5124 5148 5148 5148 5149 4125 3102 1567 0 512 2049 3330 5122 6659 8195 9988 11268 12572 11804 9757 5149 5150 5150 5151 5120 5136 5135 5134 5134 5133 5133 5132 5132 5140 5140 5139 5139 5138 4114 3089 1552 16 527 1806 3597 5133 6668 8460 9740 11284 12564 11796 9747 5139 5138 5137 5136 5136 5135 5134 5133 5133 5132 5132 5131 5141 5140 5140 5139 5139 5138 4113 3088 1551 14 269 2061 3596 5132 6923 8203 9749 11285 12565 11796 9747 5139 5138 5137 5135 5134 5133 5132 5131 5131 5131 5130 5142 5141 5141 5141 5140 5139 5138 4113 3087 1549 12 267 1803 3338 5130 6410 7958 9494 11030 12565 11797 9748 5139 5137 5134 5132 5131 5130 5130 5129 5129 5129 5143 5143 5143 5142 5142 5141 5140 5138 4108 3082 1545 9 521 2056 3848 5128 6680 8216 9496 11287 12567 11799 9750 5140 5124 5126 5127 5127 5127 5128 5128 5128 5144 5144 5144 5145 5145 5145 5146 5148 5122 4100 3077 1542 6 519 2311 3591 5145 6681 7961 9754 11290 12571 11804 9758 9729 5123 5124 5125 5125 5126 5126 5126 5146 5146 5146 5147 5147 5148 5149 5151 5121 5122 4099 3076 1541 5 773 2054 3610 5147 6427 8219 9756 11549 12574 11807 11777 9730 5123 5123 5124 5125 5125 5125 5147 5147 5147 5148 5149 5149 5150 5151 5120 5121 5122 4099 3075 1540 4 773 2331 3868 5148 6940 8477 10270 11807 12544 12544 11777 9730 5123 5123 5124 5124 5124 5148 5148 5148 5149 5149 5150 5151 5120 5120 5121 5122 5122 4099 3075 1540 4 540 2076 3357 5149 6686 8478 10015 11264 11280 12559 11790 9742 5133 5133 5132 5132 5140 5140 5139 5139 5138 5138 5137 5136 5136 5135 5134 5133 5133 4108 3084 1548 20 532 1812 3603 5139 6930 8465 9744 9488 11023 12558 11789 9741 5132 5132 5131 5141 5140 5140 5139 5139 5138 5137 5136 5135 5134 5133 5133 5132 5132 4107 3083 1557 21 21 1812 3347 5139 6674 7953 7951 9486 11021 12556 11787 9739 5131 5130 5142 5141 5141 5141 5140 5139 5138 5137 5135 5133 5132 5131 5131 5130 5130 4106 3094 1558 22 277 1813 3604 5139 6417 6670 8204 9483 11274 12554 11785 9737 5129 5143 5143 5143 5142 5142 5141 5140 5138 5132 5130 5129 5129 5129 5128 5128 5128 4120 3096 1560 23 535 2327 3862 5140

controller_0:
    set 26..30 L0..L4,
    set 16..20 L0..L4,
    set 21..25 O26..O30,
    set 31 L,
    if 7 worker_360

worker_golden:
    set 0..5 L8..L13,
    set 6..7 L,
    set 8..13 L8..L13,
    set 14..15 L,
    set 16..23 8..15,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 16,
    write 16,
    jmp controller_0

worker_360:
    set 0..5 L8..L13,
    set 6..7 L,
    set 8..13 L8..L13,
    set 14..15 L,
    set 16..23 8..15,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 16,
    write 16,
    jmp controller_0
