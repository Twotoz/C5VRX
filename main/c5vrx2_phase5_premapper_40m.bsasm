# Stage 1: 40 MS/s Pipelined Raw Q4/I4 -> 5-bit Polar Phase5 Premapper
# Consumes 1 byte packed Q4/I4 per cycle, emits 1 byte 5-bit phase per cycle.
# 1 instruction bundle per byte -> 40 MB/s sustained throughput at 40 MHz.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 8
cfg lut_width_bits 16

lut 4 6 7 7 7 8 8 8 24 24 24 25 25 25 26 28 2 4 5 6 6 7 7 7 25 25 25 26 26 27 28 30 1 3 4 5 5 6 6 6 26 26 26 27 27 28 29 31 1 2 3 4 5 5 5 6 26 27 27 27 28 29 30 31 1 2 3 3 4 5 5 5 27 27 27 28 29 29 30 31 0 1 2 3 3 4 4 5 27 28 28 28 29 30 31 0 0 1 2 3 3 4 4 4 28 28 28 29 29 30 31 0 0 1 2 2 3 3 4 4 28 28 29 29 30 30 31 0 16 15 14 14 13 13 12 12 20 20 19 19 18 18 17 16 16 15 14 13 13 12 12 12 20 20 20 19 19 18 17 16 16 15 14 13 13 12 12 11 21 20 20 19 19 18 17 16 15 14 13 13 12 12 11 11 21 21 21 20 19 19 18 17 15 14 13 12 11 11 11 10 22 21 21 21 20 19 18 17 15 13 12 11 11 10 10 10 22 22 22 21 21 20 19 17 14 12 11 10 10 9 9 9 23 23 23 22 22 21 20 18 12 10 9 9 9 8 8 8 24 24 24 23 23 23 22 20

prime:
    set 16..23 0..7,
    set 24..25 L,
    read 8

loop:
    set 0..7 L0..L7,
    set 16..23 0..7,
    set 24..25 L,
    read 8,
    write 8,
    jmp loop
