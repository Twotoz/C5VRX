# Alpha predictive exact-adjacent Phase5 M2M kernel.
#
# Input:  full packed Q4/I4 bytes at 40 MS/s.
# Output: 20 MS/s unique 6-bit CVBS duplicated as [D,D] at 40 MB/s.
#
# Alpha keeps the exact adjacent ordering from ADJ PHASE5:
#   d0 = wrap5(phi0 - phi_prev)
#   d1 = wrap5(phi1 - phi0)
#   pair = signed(d0) + signed(d1)       (NO second wrap)
#
# The final lookup is predictive and happens BEFORE CVBS is emitted:
#   address[5:0] = biased exact adjacent pair sum (0..62)
#   address[8:6] = previous accepted CVBS state (previous_code >> 3)
#   address[9]   = both new raw samples high-confidence
#
# High-confidence addresses map bit-exactly to ordinary adjacent Phase5.
# Low-confidence addresses limit innovation versus the previous accepted state,
# so one near-origin Q4 sample cannot immediately create a full-scale click.
#
# One 1024x16 LUT is shared by all stages:
#   bits 0..4   raw-Q4 -> Phase5
#   bits 5..9   phase-pair -> biased adjacent delta (signed delta + 16)
#   bits 10..15 Alpha tracker -> corrected 6-bit CVBS
#
# Raw confidence uses L10 on raw addresses 0..255. alpha_fm.c makes tracker
# code parity match that bit on those overlapping addresses, changing only
# low-confidence tracker codes by at most one DAC code.
#
# O26..O30 carries the latest Phase5 across pairs. The previous accepted Alpha
# state is free: after emit, O3..O5 already equal previous_code[5:3], and the
# next delta0_lookup snapshots those three bits before reusing low O bits.
#
# Finite M2M jobs reset O state. alpha_fm.c repairs only the bounded prefix of
# each 16 KiB half until the hardware tracker state converges with the state
# carried from the preceding half.
#
# Exactly eight instruction bundles are used.
cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16

prime:
    # Reset predictor to state 2 (centre near production pedestal 20), clear
    # previous Phase5, and issue the first raw-Q4 lookup.
    set 3 L,
    set 4 H,
    set 5 L,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    set 26..30 L,
    set 31 L,
    read 8

delta0_lookup:
    # Snapshot previous accepted CVBS state before low O is reused. L is raw0.
    # Save raw0 confidence and update persistent phase while addressing
    # LUT[previous_phase | current_phase<<5].
    set 0 O3,
    set 1 O4,
    set 2 O5,
    set 3 L10,
    set 4..15 L,
    set 16..20 O26..O30,
    set 21..25 L0..L4,
    set 26..30 L0..L4,
    set 31 L

raw1_lookup:
    # L now contains biased d0. Preserve it and fetch raw1.
    set 0..3 O0..O3,
    set 4..8 L5..L9,
    set 9..15 L,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 8

delta1_lookup:
    # L is raw1. Save raw1 confidence, update persistent phase, and address
    # LUT[phase0 | phase1<<5] for the second genuine adjacent delta.
    set 0..8 O0..O8,
    set 9 L10,
    set 10..15 L,
    set 16..20 O26..O30,
    set 21..25 L0..L4,
    set 26..30 L0..L4,
    set 31 L

sum_load:
    # Load Counter A with d0_bias in A0..A4 and conf0 in A8. Preserve the
    # predictor snapshot and final phase. L (d1) remains available next bundle.
    set 0..9 O0..O9,
    set 10..15 L,
    set 16..20 O4..O8,
    set 21..23 L,
    set 24 O3,
    set 25 L,
    set 26..30 O26..O30,
    set 31 L,
    LDCTIAL

sum_add:
    # Add d1_bias and conf1. Since d0_bias+d1_bias <= 62, no low-field carry
    # can reach confidence. A9 becomes 1 iff conf0+conf1 == 2.
    set 0..9 O0..O9,
    set 10..15 L,
    set 16..20 L5..L9,
    set 21..23 L,
    set 24 O9,
    set 25 L,
    set 26..30 O26..O30,
    set 31 L,
    ADDCTIAL

tracker_lookup:
    # Exact adjacent pair sum + previous accepted 3-bit state + pair confidence.
    set 0..15 L,
    set 16..21 A0..A5,
    set 22..24 O0..O2,
    set 25 A9,
    set 26..30 O26..O30,
    set 31 L

emit_and_prefetch:
    # L10..L15 is Alpha's corrected output. Emit [D,D]. O3..O5 therefore
    # become the next predictor state automatically. Prefetch next raw0.
    set 0..5 L10..L15,
    set 6..7 L,
    set 8..13 L10..L15,
    set 14..15 L,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 8,
    write 16,
    jmp delta0_lookup
