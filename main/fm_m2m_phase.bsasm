prime:
    # Address the oldest prefetched raw byte, then advance one sample.
    set 16..23 0..7,
    set 24..25 L,
    read 8

convert:
    # Emit sparse Phase5 bits from the shared resident LIFT LUT while
    # addressing/reading the next raw byte.
    set 0 L6,
    set 1 L7,
    set 2 L13,
    set 3 L14,
    set 4 L15,
    set 5..7 L,
    set 16..23 0..7,
    set 24..25 L,
    read 8,
    write 8,
    jmp convert
