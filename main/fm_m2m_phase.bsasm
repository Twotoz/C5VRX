# M2M stage 1: full raw Q4/I4 -> Phase5 + amplitude class.
#
# Input : one packed Q4/I4 byte per 25 ns (40 MS/s).
# Output: one byte per input sample, same 40 MB/s ring bandwidth.
#
#   bits 0..4 = exact production Phase5 state
#   bits 5..7 = coarse raw-power / origin / overload class
#
# Output bits 0..4 are exact production Phase5. ARC/Fusion continue reading
# the untouched raw RX ring, so this scratch stream needs no amplitude metadata.
#
# The LUT is byte-identical to fm_m2m_lift.bsasm. Phase5 is packed into the
# five spare LIFT word bits L6,L7,L13,L14,L15, allowing one physical LUT to
# stay resident while only instruction RAM changes between M2M passes.
#
# Finite M2M blocks intentionally use upstream EOF with no synthetic tail.
# Any deterministic final pipeline shortfall is held at the previous CVBS code
# by the block scheduler; fake zero-phase tail samples are never demodulated.
# Steady state is one BitScrambler bundle per input byte. This program runs
# in single-core memory-to-memory loopback mode; PARLIO uses no BitScrambler.
cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 0
cfg lut_width_bits 16
lut 8212 9870 9672 9666 11732 17166 16904 16642 49178 50708 50446 50504 53850 50004 49806 57608 160 9754 9556 9614 9632 11738 8916 8654 49254 50784 50522 50580 50598 53984 57882 57748 108 1766 9504 9562 9580 9638 11424 8602 49330 50860 50598 50656 50674 58668 61798 57824 120 1714 1516 9510 9592 9586 9580 11174 49342 50936 50674 50668 58686 58744 58802 61676 2687 2238 1272 1266 9279 9342 13944 13426 53247 51711 51198 59192 59263 59263 63422 62968 63 3711 959 1022 1023 9023 8767 8574 49407 62271 58175 58175 58239 58303 58111 319 63 1663 3519 1023 1023 9023 8767 8511 57407 58943 62015 58239 58239 58303 58111 319 63 1663 1471 3519 1023 1023 8767 8511 57407 58943 58751 62079 58303 58303 58111 319 33024 24768 26240 25984 28031 25471 25407 25151 41216 40960 34496 34240 37504 33664 33600 33280 33024 24768 26240 25920 25920 27904 25344 25088 41216 40960 42496 34240 34240 37504 33600 33280 33024 24768 26240 25920 25920 25856 27904 17088 41280 40960 42496 34240 34240 34176 37440 33280 25024 24704 26176 25920 25856 25856 17856 19648 41280 41024 42560 42240 34240 34240 34176 37184 27584 24704 26176 25856 17856 17856 17856 17792 45186 41024 42560 42304 42242 34240 34176 34112 29896 27202 26624 17600 17608 17538 17536 22144 46478 44936 43394 42816 42830 42760 34754 38720 25023 24639 20223 17343 17343 17279 17279 17023 41471 41215 46079 41919 41919 41855 41791 33471 24832 16512 17984 19776 17279 17215 17215 16959 49408 49152 50688 45760 41920 41920 41856 41472 512 256 0 1536 3391 831 831 831 514 256 0 1536 4610 768 768 768 520 258 0 1536 1288 3330 768 768 526 264 2 1536 1294 4616 770 768 575 319 63 1599 1343 1343 3391 831 575 319 63 1599 1343 1343 4671 831 520 258 0 1536 1343 1343 1343 3391 526 264 2 1536 1294 1288 1282 4608 3072 270 8 1538 1300 1294 1343 1343 4352 276 14 1544 1280 1280 1294 1288 1280 2842 20 1550 1280 1280 1300 1294 1280 4128 26 1556 1280 1280 1306 1300 5632 5158 2592 2074 1024 1024 1056 1050 5888 5420 3878 2336 1792 1792 1830 1824 512 306 44 3622 768 768 812 806 