prime:
    set 16..23 0..7,
    set 24..26 L,
    set 27 7,
    read 8

stream:
    set 0..5 L0..L5,
    set 6..7 L,
    set 16..23 0..7,
    set 24..25 L6..L7,
    set 26 O27,
    set 27 7,
    read 8,
    write 8,
    jmp stream
