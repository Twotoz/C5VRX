# Experimental exact-adjacent M2M demodulator.
#
# Two packed Q4/I4 bytes are consumed for every 20 MS/s video result.
# Every adjacent 40 MS/s interval participates:
#
#   d0 = wrap(phi[m] - phi[p])
#   d1 = wrap(phi[c] - phi[m])
#   pair = d0 + d1
#
# IMPORTANT: pair is NOT wrapped again. Phase is represented on a 7-bit
# circle so two signed adjacent deltas fit losslessly in an 8-bit signed sum.
#
# Persistent state:
#   A[14:8] = -phase(previous) modulo 128
#   A[15]   = middle-sample low-confidence flag for the current pair
#   A[6:0]  = temporary wrapped adjacent delta
#   B       = signed no-rewrap pair accumulator
#   O29..31 immediately after emit = coarse previous final CVBS
#   O8..10 during the working loop = the same coarse previous CVBS
#
# O0..O7 is scratch used to retain the current phase LUT metadata while
# counter instructions temporarily repurpose the LUT-address output bits.
#
# LUT layout (16-bit entries):
#   0x000..0x0ff raw Q4/I4 ->
#       bits 0..6   phase7
#       bit  7      low-confidence quantization cell
#       bits 9..15  -phase7 modulo 128
#   0x100..0x1ff pair-map ->
#       bits 0..4   5-bit candidate CVBS (one-LSB reduced)
#       bit  5      confidence-gated winding hold request
#   0x200..0x3ff hold-map ->
#       bits 0..5   final 6-bit CVBS
#
# Low-confidence winding events use a short coarse holdover from the previous
# output. Large credible FM motion is never smoothed merely because it is large.
#
# This program is memory-to-memory only. It intentionally uses upstream EOF
# because each half-ring transform is a bounded loopback transaction. The live
# DAC consumes the already duplicated [D,D] output ring without a BitScrambler.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16

address1:
    # Move prior CVBS hold state out of the high address area, address sample 1,
    # and reset the full signed pair accumulator B.
    set 8..10 O29..O31,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..31 L,
    read 8,
    LDCTDB 0

load_current1:
    # Save current -phase/confidence in O scratch while loading phase into A.low.
    set 0..6 L9..L15,
    set 7 L7,
    set 8..10 O8..O10,
    set 16..22 L0..L6,
    set 23..31 L,
    LDCTIAL

add_previous1:
    set 0..7 O0..O7,
    set 8..10 O8..O10,
    set 16..22 A8..A14,
    set 23..31 L,
    ADDCTIAL

accumulate1:
    # Sign-extend the wrapped 7-bit d0 from A6 into full counter B.
    set 0..7 O0..O7,
    set 8..10 O8..O10,
    set 16..22 A0..A6,
    set 23..31 A6,
    ADDCTIB

save_middle:
    # A.high = {-phase(middle), low-confidence(middle)}.
    set 8..10 O8..O10,
    set 24..30 O0..O6,
    set 31 O7,
    LDCTIAH

address2:
    set 8..10 O8..O10,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..31 L,
    read 8

load_current2:
    set 0..6 L9..L15,
    set 7 L7,
    set 8..10 O8..O10,
    set 16..22 L0..L6,
    set 23..31 L,
    LDCTIAL

add_previous2:
    set 0..7 O0..O7,
    set 8..10 O8..O10,
    set 16..22 A8..A14,
    set 23..31 L,
    ADDCTIAL

accumulate2:
    set 0..7 O0..O7,
    set 8..10 O8..O10,
    set 16..22 A0..A6,
    set 23..31 A6,
    ADDCTIB

save_current:
    # Keep current -phase for the next pair, but retain middle confidence A15.
    set 8..10 O8..O10,
    set 24..30 O0..O6,
    set 31 A15,
    LDCTIAH

pair_map:
    # B is the no-rewrap signed pair sum (-128..+126 phase7 units).
    # B1..B7 is arithmetic /2 in signed 7-bit form. Bank 0x100 maps it to
    # quiet 20 MS/s CVBS and flags only low-confidence winding events.
    set 8..10 O8..O10,
    set 16..22 B1..B7,
    set 23 A15,
    set 24 H,
    set 25 L,
    set 26..31 L

hold_map:
    # Bank 0x200:
    # address[4:0] = candidate code / 2
    # address[7:5] = previous output coarse state
    # address[8]   = confidence-gated hold request
    # address[9]   = bank select
    set 8..10 O8..O10,
    set 16..20 L0..L4,
    set 21..23 O8..O10,
    set 24 L5,
    set 25 H,
    set 26..31 L

emit:
    # Final 20 MS/s value duplicated physically as [D,D] at 40 MHz.
    # Save its upper three bits in O29..31 for a possible next-sample hold.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 16..28 L,
    set 29..31 L3..L5,
    write 16,
    jmp address1
