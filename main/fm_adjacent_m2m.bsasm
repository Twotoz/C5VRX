# Experimental exact-adjacent M2M demodulator.
#
# Two packed Q4/I4 bytes are consumed for every 20 MS/s video result.
# Every adjacent 40 MS/s interval participates:
#
#   d0 = wrap(phi[m] - phi[p])
#   d1 = wrap(phi[c] - phi[m])
#   pair = d0 + d1
#
# IMPORTANT: pair is NOT wrapped again. Phase is represented on a 7-bit
# circle so two signed adjacent deltas fit losslessly in an 8-bit signed sum.
#
# State:
#   A[14:8] = -phase(previous) modulo 128
#   A[15]   = middle-sample low-confidence flag for the current pair
#   A[6:0]  = temporary wrapped adjacent delta
#   B       = signed no-rewrap pair accumulator
#   O29..31 = coarse previous final CVBS for confidence holdover
#
# LUT layout (16-bit entries):
#   0x000..0x0ff raw Q4/I4 ->
#       bits 0..6   phase7
#       bit  7      low-confidence quantization cell
#       bits 9..15  -phase7 modulo 128
#   0x100..0x1ff pair-map ->
#       bits 0..4   5-bit candidate CVBS (one-LSB reduced)
#       bit  5      confidence-gated winding hold request
#   0x200..0x3ff hold-map ->
#       bits 0..5   final 6-bit CVBS
#
# Low-confidence winding events use a short coarse holdover from the previous
# output. Large credible FM motion is never smoothed merely because it is large.
#
# This program is memory-to-memory only. It intentionally uses upstream EOF
# because each half-ring transform is a bounded loopback transaction. The live
# DAC consumes the already duplicated [D,D] output ring without a BitScrambler.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16

address1:
    # Address first new sample and reset the signed pair accumulator B.
    # Counter A persists -phase(previous) across steady-state pairs.
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..28 L,
    set 29..31 O29..O31,
    read 8,
    LDCTDB 0

load_current1:
    # A.low = phase(current); A.high still holds -phase(previous).
    set 16..25 O16..O25,
    set 29..31 O29..O31,
    set 16..22 L0..L6,
    LDCTIAL

add_previous1:
    # A.low += A.high[6:0], yielding wrapped d0 modulo 128.
    set 16..25 O16..O25,
    set 29..31 O29..O31,
    set 16..22 A8..A14,
    ADDCTIAL

accumulate1:
    # Sign-extend d0 from A6 and add to the full 16-bit pair accumulator.
    set 16..22 A0..A6,
    set 23..28 A6,
    set 29..31 O29..O31,
    ADDCTIB

save_middle:
    # Preserve -phase(middle) and its confidence in A.high.
    set 24..30 L9..L15,
    set 31 L7,
    set 29..31 O29..O31,
    LDCTIAH

address2:
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..28 L,
    set 29..31 O29..O31,
    read 8

load_current2:
    set 16..25 O16..O25,
    set 29..31 O29..O31,
    set 16..22 L0..L6,
    LDCTIAL

add_previous2:
    set 16..25 O16..O25,
    set 29..31 O29..O31,
    set 16..22 A8..A14,
    ADDCTIAL

accumulate2:
    set 16..22 A0..A6,
    set 23..28 A6,
    set 29..31 O29..O31,
    ADDCTIB

save_current:
    # Keep -phase(current) for the next pair but retain middle confidence A15.
    set 24..30 L9..L15,
    set 31 A15,
    set 29..31 O29..O31,
    LDCTIAH

pair_map:
    # B is the no-rewrap signed pair sum (-128..+126 phase7 units).
    # B1..B7 is an arithmetic /2 in signed 7-bit form. Bank 0x100 maps it
    # to quiet 20 MS/s CVBS and flags only low-confidence winding events.
    set 16..22 B1..B7,
    set 23 A15,
    set 24 H,
    set 25 L,
    set 26..28 L,
    set 29..31 O29..O31

hold_map:
    # Bank 0x200 combines the candidate with a coarse previous-output state.
    set 16..20 L0..L4,
    set 21..23 O29..O31,
    set 24 L5,
    set 25 H,
    set 26..28 L,
    set 29..31 O29..O31

emit:
    # Final 20 MS/s value duplicated physically as [D,D] at 40 MHz.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 16..28 L,
    set 29..31 L3..L5,
    write 16,
    jmp address1
