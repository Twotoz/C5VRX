# Exact-adjacent Phase5 M2M demodulator.
#
# Full Q4/I4 is phase-quantized for EVERY acquired 40 MS/s sample. Two genuine
# adjacent Phase5 deltas are then summed in signed arithmetic:
#
#   d0 = wrap5(middle - previous)   [-16, +15]
#   d1 = wrap5(current - middle)    [-16, +15]
#   pair = d0 + d1                  [-32, +30]
#
# pair is NEVER wrapped again. This preserves the middle-sample winding that
# Golden's 50 ns endpoint discriminator loses.
#
# LUT word roles share non-overlapping bit fields:
#   bits 0..4   signed delta5 for (previous_phase,current_phase) addresses
#   bits 5..9   final CVBS/2 for (pair,confidence,previous-CVBS) addresses
#   bits 10..14 Phase5 for raw Q4/I4 addresses
#   bit  15     Q4-cell low-confidence flag for raw addresses
#
# Persistent after emit:
#   O23..O25 previous final CVBS bits 3..5 (coarse holdover bucket)
#   O26..O30 previous Phase5
#
# Working scratch:
#   O0..O4 middle Phase5
#   O5     middle confidence
#   O6..O8 previous CVBS coarse state
#   O9..O13 current Phase5
#
# Eight instruction bundles exactly: the ESP32-C5 hardware maximum.
# M2M is finite, so upstream EOF/trailing bytes are intentional.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16

address_middle:
    # Move persistent hold state to low scratch, preserve previous Phase5,
    # and address the first raw Q4/I4 byte of this pair.
    set 6..8 O23..O25,
    set 26..30 O26..O30,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    set 31 L,
    read 8

middle_address_current:
    # Raw lookup: Phase5=L10..L14, low-confidence=L15.
    set 0..4 L10..L14,
    set 5 L15,
    set 6..8 O6..O8,
    set 26..30 O26..O30,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    set 31 L,
    read 8

current_address_d0:
    # Save current Phase5, then lookup d0 from previous->middle.
    set 0..8 O0..O8,
    set 9..13 L10..L14,
    set 26..30 O26..O30,
    set 16..20 O0..O4,
    set 21..25 O26..O30,
    set 31 L

load_d0:
    # Sign-extend LUT delta5 into signed 8-bit Counter A.
    set 0..13 O0..O13,
    set 26..30 O26..O30,
    set 16..20 L0..L4,
    set 21..23 L4,
    set 24..25 L,
    set 31 L,
    LDCTIAL

address_d1:
    # d1 = middle->current.
    set 0..13 O0..O13,
    set 26..30 O26..O30,
    set 16..20 O9..O13,
    set 21..25 O0..O4,
    set 31 L

add_d1:
    # Sign-extend d1 and add it to d0. Counter A now contains the exact signed
    # pair sum. No modulo-32/endpoint re-wrap is performed.
    set 0..13 O0..O13,
    set 26..30 O26..O30,
    set 16..20 L0..L4,
    set 21..23 L4,
    set 24..25 L,
    set 31 L,
    ADDCTIAL

address_final:
    # final address:
    #   bits 0..5 = signed pair sum (two's complement)
    #   bit 6     = middle Q4-cell low confidence
    #   bits 7..9 = previous output coarse state
    set 0..13 O0..O13,
    set 16..21 A0..A5,
    set 22 O5,
    set 23..25 O6..O8,
    set 26..30 O26..O30,
    set 31 L

emit:
    # LUT L5..L9 stores final_code/2. All Phase5 adjacent map codes and hold
    # bucket centers are even, so this reconstruction loses no additional bit.
    # Duplicate the quiet 20-MS/s result as [D,D] at the physical 40-MHz DAC.
    set 0 L,
    set 1..5 L5..L9,
    set 6..7 L,
    set 8 L,
    set 9..13 L5..L9,
    set 14..15 L,
    set 16..22 L,
    set 23..25 L7..L9,
    set 26..30 O9..O13,
    set 31 L,
    write 16,
    jmp address_middle
