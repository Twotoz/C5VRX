# Exact adjacent-Phase5 FM M2M kernel.
#
# Input:  full packed Q4/I4 bytes at 40 MS/s.
# Output: 20 MS/s unique 6-bit CVBS duplicated as [D,D] at 40 MB/s.
#
# This deliberately uses the SAME 5-bit circular phase quantizer as Golden so
# the live A/B changes trajectory ordering rather than phase resolution:
#
#   Golden:  phase[n-2] ----------------> phase[n]   (endpoint)
#   ADJ:     phase[n-2] -> phase[n-1] -> phase[n]   (two adjacent deltas)
#
# LUT word layout:
#   bits  0..5  final CVBS for address (d0_5 | d1_5<<5)
#   bits  6..10 positive Phase5 for raw-Q4 addresses 0..255
#   bits 11..15 negative Phase5 for raw-Q4 addresses 0..255
#
# d0 and d1 are kept separately as 5-bit circular deltas and only combined by
# the final 32x32 LUT. There is therefore NO second wrap of d0+d1.
#
# O26..O30 retains -Phase5(current) between output pairs. Finite M2M runs reset
# this state, so adjacent_fm.c repairs output pair 0 from the preceding raw byte.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16

prime:
    # Prime the first raw Q4/I4 lookup. The first pair's previous phase is
    # unavailable after a finite M2M reset and is repaired by adjacent_fm.c.
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    read 8

load_current1:
    # Save old -phase in O0..O4, retain new -phase in O26..O30, and initialize
    # A low with current Phase5 * 8 on the phase8 circle.
    set 0..4 O26..O30,
    set 5..18 L,
    set 19..23 L6..L10,
    set 24..25 L,
    set 26..30 L11..L15,
    set 31 L,
    LDCTIAL

add_previous1:
    # A = wrap8(+phase1 + -phase_previous); bits A3..A7 are exact d0_5.
    set 0..18 L,
    set 19..23 O0..O4,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    ADDCTIAL

address2:
    # Preserve d0 and -phase1 while addressing the middle/current second sample.
    set 5..9 A3..A7,
    set 10..14 O26..O30,
    set 15 L,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 8

load_current2:
    # Initialize A with phase2 * 8 and retain -phase2 for the next output pair.
    set 5..14 O5..O14,
    set 15..18 L,
    set 19..23 L6..L10,
    set 24..25 L,
    set 26..30 L11..L15,
    set 31 L,
    LDCTIAL

add_previous2:
    # A = wrap8(+phase2 + -phase1); bits A3..A7 are exact d1_5.
    set 5..9 O5..O9,
    set 10..18 L,
    set 19..23 O10..O14,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    ADDCTIAL

map_pair:
    # Final LUT address: d0_5 in bits 0..4, d1_5 in bits 5..9.
    # The table converts signed(d0)+signed(d1) directly to CVBS; it never wraps
    # the pair sum back onto the 5-bit phase circle.
    set 0..15 L,
    set 16..20 O5..O9,
    set 21..25 A3..A7,
    set 26..30 O26..O30,
    set 31 L

emit_and_prefetch:
    # Emit [D,D] and prefetch the first raw sample of the next pair.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 8,
    write 16,
    jmp load_current1
