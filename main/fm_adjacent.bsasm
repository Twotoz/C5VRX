# Experimental full-Q4 adjacent-FM M2M kernel.
#
# Input:  packed Q4/I4 bytes at 40 MS/s.
# Output: 6-bit CVBS at 20 MS/s duplicated as [D,D], so output byte rate
#         remains 40 MB/s for the proven 40 MHz resistor-DAC transport.
#
# The LUT is loaded by adjacent_fm.c:
#   0x000..0x0ff: raw Q4/I4 -> {phase8, -phase8}
#   0x100..0x1ff: signed accumulated pair delta -> P20/G2 CVBS code
#
# Counter A accumulates two genuine adjacent wrapped deltas. Counter B keeps
# the negative phase of the final sample across pairs. A finite M2M run resets
# transport state at a block boundary; adjacent_fm.c therefore repairs the
# first [D,D] pair from the previous raw sample after each run.
#
# This is intentionally an M2M program, not a PARLIO TX decorator:
# upstream EOF/trailing bytes are required to flush bounded half-ring jobs.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16

address1:
    # Address first raw Q4/I4 byte and clear the per-pair accumulator.
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    read 8,
    LDCTDAL 0

add_current1:
    # Save -phase(sample1) in O0..O7 and add +phase(sample1).
    set 0..7 L8..L15,
    set 16..23 L0..L7,
    ADDCTIAL

add_previous1:
    # B low byte holds -phase(previous sample).
    set 0..7 O0..O7,
    set 16..23 B0..B7,
    ADDCTIAL

address2:
    # Preserve -phase(sample1), then address sample2.
    set 0..7 O0..O7,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    read 8

add_current2:
    # Preserve -phase(sample1), save -phase(sample2), add +phase(sample2).
    set 0..7 O0..O7,
    set 8..15 L8..L15,
    set 16..23 L0..L7,
    ADDCTIAL

add_previous2:
    # Add -phase(sample1). A now contains the two adjacent deltas.
    set 8..15 O8..O15,
    set 16..23 O0..O7,
    ADDCTIAL

map_cvbs:
    # Bank 1 maps the accumulated signed phase8 sum to a legal 6-bit code.
    set 8..15 O8..O15,
    set 16 A0,
    set 17 A1,
    set 18 A2,
    set 19 A3,
    set 20 A4,
    set 21 A5,
    set 22 A6,
    set 23 A7,
    set 24 H,
    set 25 L

emit:
    # Duplicate CVBS as [D,D]. At the same time load B with -phase(sample2)
    # for the next adjacent pair.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 16..23 O8..O15,
    set 24..31 L,
    LDCTIBL,
    write 16,
    jmp address1
