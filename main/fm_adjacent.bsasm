# Experimental exact full-Q4 adjacent-FM M2M kernel.
#
# Input:  packed Q4/I4 bytes at 40 MS/s.
# Output: 6-bit CVBS at 20 MS/s duplicated as [D,D], so output byte rate
#         remains 40 MB/s for the proven 40 MHz resistor-DAC transport.
#
# The LUT is loaded by adjacent_fm.c:
#   0x000..0x0ff: raw Q4/I4 -> {phase8, -phase8}
#   0x200..0x3ff: signed 9-bit adjacent pair sum -> P20/G2 CVBS code
#
# Exact ordering:
#   d0 = wrap8(phi1 - phi0)
#   d1 = wrap8(phi2 - phi1)
#   pair = sign_extend(d0) + sign_extend(d1)
#   CVBS = map(pair)
#
# The pair sum is NOT wrapped a second time. Counter A/B temporarily hold
# sign-extended adjacent deltas so A8 carries the required winding state into
# the 512-entry final map bank.
#
# O8..O15 retains -phase(previous) across steady-state pairs. A finite M2M run
# resets transport state at a block boundary; adjacent_fm.c repairs the first
# [D,D] pair from the previous raw sample after each run.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16

address1:
    # Address sample 1 and reset the low-byte delta accumulator.
    set 8..15 O8..O15,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    read 8,
    LDCTDAL 0

add_current1:
    # O0..O7 = -phase1, O8..O15 = -phase(previous).
    set 0..7 L8..L15,
    set 8..15 O8..O15,
    set 16..23 L0..L7,
    ADDCTIAL

add_previous1:
    set 0..15 O0..O15,
    set 16..23 O8..O15,
    ADDCTIAL

sign_d0:
    # A low now contains wrapped d0. Sign-extend it before pair accumulation.
    set 0..15 O0..O15,
    set 16..23 A0..A7,
    set 24 A7,
    set 25 A7,
    set 26 A7,
    set 27 A7,
    set 28 A7,
    set 29 A7,
    set 30 A7,
    set 31 A7,
    LDCTIA

address2:
    # Address sample 2 while preserving -phase1. Clear B low for d1.
    set 0..15 O0..O15,
    set 16 0,
    set 17 1,
    set 18 2,
    set 19 3,
    set 20 4,
    set 21 5,
    set 22 6,
    set 23 7,
    set 24..25 L,
    read 8,
    LDCTDBL 0

add_current2:
    # Replace retained previous phase with -phase2 for the next pair.
    set 0..7 O0..O7,
    set 8..15 L8..L15,
    set 16..23 L0..L7,
    ADDCTIBL

add_previous2:
    set 0..15 O0..O15,
    set 16..23 O0..O7,
    ADDCTIBL

sign_d1:
    # B low now contains wrapped d1. Sign-extend independently.
    set 0..15 O0..O15,
    set 16..23 B0..B7,
    set 24 B7,
    set 25 B7,
    set 26 B7,
    set 27 B7,
    set 28 B7,
    set 29 B7,
    set 30 B7,
    set 31 B7,
    LDCTIB

pair_sum:
    # Full-width add preserves d0+d1 in [-256,+254].
    set 0..15 O0..O15,
    set 16..31 B0..B15,
    ADDCTIA

map_cvbs:
    # Address 0x200 | (pair & 0x1ff): A0..A8 plus bank bit 9.
    set 0..15 O0..O15,
    set 16 A0,
    set 17 A1,
    set 18 A2,
    set 19 A3,
    set 20 A4,
    set 21 A5,
    set 22 A6,
    set 23 A7,
    set 24 A8,
    set 25 H

emit:
    # Duplicate the exact 20-MS/s CVBS code to the 40-MHz DAC transport.
    set 0..5 L0..L5,
    set 6..7 L,
    set 8..13 L0..L5,
    set 14..15 L,
    set 16..31 L,
    write 16,
    jmp address1
