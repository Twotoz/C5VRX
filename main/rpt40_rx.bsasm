# Generated from full Golden Q4/I4 mapping; confidence in bits 7:5.
# One prime, one repeating bundle/byte. Physical RX40 gate required.
cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16
lut 4 6 39 39 71 104 136 136 152 152 120 89 57 57 26 28 2 4 37 70 70 103 135 135 153 153 121 90 90 59 28 30 33 35 36 69 101 102 134 166 186 154 122 123 91 60 61 63 33 66 67 68 101 133 133 166 186 155 155 123 92 93 94 63 65 66 99 99 100 133 165 165 187 187 155 124 125 125 94 95 96 97 98 131 131 132 164 197 219 188 156 156 157 126 127 96 128 129 130 131 163 164 164 196 220 188 188 189 157 158 159 128 128 129 162 162 163 195 196 196 220 220 221 189 190 190 159 128 144 143 174 174 173 205 204 204 212 212 211 179 178 178 145 144 144 143 142 141 173 172 172 204 212 180 180 179 147 146 145 144 112 111 110 141 141 140 172 203 213 180 148 147 147 114 113 112 79 78 109 109 108 140 171 171 181 181 149 116 115 115 82 81 47 78 77 76 107 139 139 170 182 149 149 117 84 83 82 49 47 45 44 75 107 106 138 170 182 150 118 117 85 52 51 49 14 12 43 74 74 105 137 137 151 151 119 86 86 53 20 18 12 10 41 41 73 104 136 136 152 152 120 87 55 55 22 20

prime:
    set 16..23 0..7,
    read 8

map:
    set 0..7 L0..L7,
    set 16..23 0..7,
    read 8,
    write 8,
    jmp map
