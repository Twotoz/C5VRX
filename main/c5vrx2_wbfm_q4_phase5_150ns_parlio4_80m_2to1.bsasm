address_phase:
    set 26..30 L,
    set 16..23 8..15,
    set 24..25 L,
    read 16

step0_delta:
    set 16..20 L8..L12,
    set 21..25 A0..A4,
    set 26..30 O26..O30,
    set 31 L,
    LDCTIAL

step0_emit:
    set 0..3 L0..L3,
    set 4..7 L0..L3,
    set 8..11 L0..L3,
    set 12..15 L0..L3,
    set 16..23 8..15,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 16,
    write 16

step1_delta:
    set 16..20 L8..L12,
    set 21..25 A10..A14,
    set 26..30 L8..L12,
    set 31 L,
    LDCTIAH

step1_emit:
    set 0..3 L0..L3,
    set 4..7 L0..L3,
    set 8..11 L0..L3,
    set 12..15 L0..L3,
    set 16..23 8..15,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 16,
    write 16

step2_delta:
    set 16..20 L8..L12,
    set 21..25 O26..O30,
    set 26..30 L8..L12,
    set 31 L

step2_emit:
    set 0..3 L0..L3,
    set 4..7 L0..L3,
    set 8..11 L0..L3,
    set 12..15 L0..L3,
    set 16..23 8..15,
    set 24..25 L,
    set 26..30 O26..O30,
    set 31 L,
    read 16,
    write 16,
    jmp step0_delta