menu "C5VRX analog receiver research"

choice C5VRX_RF_BACKEND
    prompt "RF bring-up backend"
    default C5VRX_RF_BACKEND_WIFI5
    help
        The public Wi-Fi driver is the default because ESP-IDF officially
        supports 5 GHz operation on ESP32-C5. The certification/test RX API
        currently documents only channel numbers 1-14 and is therefore kept
        as a separate research backend rather than being treated as a proven
        5 GHz tuner.

config C5VRX_RF_BACKEND_WIFI5
    bool "Public ESP-IDF 5 GHz Wi-Fi driver (recommended)"

config C5VRX_RF_BACKEND_CERT_TEST
    bool "RF certification/test PHY (experimental; documented channels 1-14)"

endchoice

choice C5VRX_TARGET_BAND
    prompt "Default analog FPV band"
    default C5VRX_TARGET_BAND_R

config C5VRX_TARGET_BAND_A
    bool "A / Boscam A"
config C5VRX_TARGET_BAND_B
    bool "B / Boscam B"
config C5VRX_TARGET_BAND_E
    bool "E / Boscam E"
config C5VRX_TARGET_BAND_F
    bool "F / FatShark"
config C5VRX_TARGET_BAND_R
    bool "R / RaceBand"

endchoice

config C5VRX_TARGET_CHANNEL
    int "Default FPV channel"
    range 1 8
    default 5
    help
        Channel number inside the selected analog FPV band.

config C5VRX_RX_HT40
    bool "Use 40 MHz Wi-Fi RX bandwidth for bootstrap"
    default y
    help
        Wide bootstrap bandwidth makes early analog-FPV experiments tolerant
        of offsets between the requested FPV center and a normal Wi-Fi center.

config C5VRX_EXPERIMENTAL_DIRECT_TUNE
    bool "Enable undocumented phy_set_freq() retune experiment"
    default n
    help
        EXPERIMENTAL. After a receive backend is active on the nearest standard
        Wi-Fi center, call the weak two-argument phy_set_freq(freq_mhz, offset)
        hook to attempt an arbitrary-frequency retune. Leave disabled until
        testing with a controlled RF source.

config C5VRX_EXPERIMENTAL_ADC_DUMP
    bool "Run one finite vendor ADC/IQ dump after RF bring-up"
    default n
    help
        EXPERIMENTAL. ESP-IDF v6.0.2 static analysis identifies a 64 KiB
        vendor RF-test capture buffer with packed signed 10-bit I/Q samples.
        This option triggers one finite capture after the RF backend starts.
        The path is not yet validated on physical ESP32-C5 hardware.

config C5VRX_ADC_DUMP_SAMPLES
    int "ADC/IQ samples per finite capture"
    range 256 16384
    default 8192
    depends on C5VRX_EXPERIMENTAL_ADC_DUMP
    help
        Number of complex 32-bit dump words to process. The recovered vendor
        buffer at 0x40830000 is 64 KiB, so the maximum is 16384 samples.

config C5VRX_ADC_DUMP_PRINT_RAW
    bool "Print raw capture words as IQ:xxxxxxxx lines"
    default n
    depends on C5VRX_EXPERIMENTAL_ADC_DUMP
    help
        Emit machine-readable raw 32-bit dump words over the console. This is
        intentionally disabled by default because thousands of serial lines are
        slow. Enable it for captures that will be decoded on a host PC.

config C5VRX_EXPERIMENTAL_CVBS_PARLIO
    bool "Enable analog-first PARLIO CVBS resistor-DAC test output"
    default n
    help
        EXPERIMENTAL OUTPUT-SIDE TEST. Adds the CVBS TEST / CVBS STOP USB
        commands. CVBS TEST loops a 20 MS/s PAL-line-like waveform through
        PARLIO so the analog output half can be validated independently from
        the RF receive path.

        The reference architecture transports one byte per sample but uses six
        physical low-order GPIO bits and a weighted resistor network into a
        known 75-ohm terminated video input. No external DAC IC is required for
        this minimum-hardware experiment.

        A short-trace passive output is the baseline. Long cables, ESD targets
        or strict production video-drive requirements may justify an optional
        buffer later, but a buffer is not assumed to be mandatory.

config C5VRX_CVBS_DAC_BITS
    int "Physical CVBS resistor-DAC bits"
    range 2 8
    default 6
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO
    help
        Number of physical GPIO/resistor bits used for composite output.
        PARLIO still transports one byte per sample; unused upper GPIOs remain
        disconnected.

        Six bits are the analog-first reference target. This gives 64 output
        codes while requiring only six GPIOs. Lower bit depths remain useful
        for BOM/quality experiments; 7-8 bits should only be used if measured
        video quality justifies the extra pins and passives.

config C5VRX_CVBS_D0_GPIO
    int "CVBS DAC bit 0 GPIO"
    range -1 30
    default -1
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO
config C5VRX_CVBS_D1_GPIO
    int "CVBS DAC bit 1 GPIO"
    range -1 30
    default -1
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO
config C5VRX_CVBS_D2_GPIO
    int "CVBS DAC bit 2 GPIO"
    range -1 30
    default -1
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO
config C5VRX_CVBS_D3_GPIO
    int "CVBS DAC bit 3 GPIO"
    range -1 30
    default -1
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO
config C5VRX_CVBS_D4_GPIO
    int "CVBS DAC bit 4 GPIO"
    range -1 30
    default -1
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO
config C5VRX_CVBS_D5_GPIO
    int "CVBS DAC bit 5 GPIO"
    range -1 30
    default -1
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO
config C5VRX_CVBS_D6_GPIO
    int "CVBS DAC bit 6 GPIO"
    range -1 30
    default -1
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO
config C5VRX_CVBS_D7_GPIO
    int "CVBS DAC bit 7 GPIO"
    range -1 30
    default -1
    depends on C5VRX_EXPERIMENTAL_CVBS_PARLIO

endmenu
