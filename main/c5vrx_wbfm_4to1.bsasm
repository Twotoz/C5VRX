# C5VRX packed IQ -> 20 MS/s biased phase-delta proof.
#
# Input word layout recovered from the C5 RF-test dump:
#   bits  0..9  Q signed 10-bit
#   bits 10..19 I signed 10-bit
#
# The program consumes four 32-bit input words for every one output byte. At an
# 80 MS/s upstream IQ rate this produces a 20 MS/s stream, matching the current
# CVBS PARLIO target. The first output after a program reset is a priming sample;
# subsequent values are valid modulo-64 phase deltas around bias code 32.
#
# LUT entry layout (1024 x 16-bit = exactly 2048 bytes):
#   L0..L5   phase6 from coarse I5/Q5
#   L8..L13  (32 - phase6) modulo 64
#
# Counter B low six bits therefore implement:
#   B = 32 - previous_phase
#   B += current_phase
#   output B0..B5 = 32 + current_phase - previous_phase
#
# Address bits are kept in O22..O31 while counter operations use O16..O23.
# O22/O23 contaminate counter bits 6/7, but the low six bits are mathematically
# unaffected, which is the only portion written to the 6-bit video DAC.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 0
cfg lut_width_bits 16

lut 0x1808, 0x130d, 0x120e, 0x110f, 0x110f, 0x110f, 0x110f, 0x110f, 0x110f, 0x110f, 0x1010, 0x1010, 0x1010, 0x1010, 0x1010, 0x1010
