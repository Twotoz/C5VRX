init:
    LDCTDBL 32

sample_address:
    set 22..26 5..9,
    set 27..31 15..19,
    read 32,
    jmp phase_add

phase_add:
    set 16..21 L0..L5,
    set 22..31 O22..O31,
    read 32,
    ADDCTIBL

emit_and_remember:
    set 0..5 B0..B5,
    set 16..21 L8..L13,
    set 22..31 O22..O31,
    read 32,
    write 8,
    LDCTIBL

decimate_fourth:
    read 32,
    jmp sample_address
