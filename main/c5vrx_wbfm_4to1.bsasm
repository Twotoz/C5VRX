# C5VRX packed IQ -> 20 MS/s biased phase-delta proof.
#
# Input word layout recovered from the C5 RF-test dump:
#   bits  0..9  Q signed 10-bit
#   bits 10..19 I signed 10-bit
#
# The program consumes four 32-bit input words for every one output byte. At an
# 80 MS/s upstream IQ rate this produces a 20 MS/s stream, matching the current
# CVBS PARLIO target. The first output after reset is a priming sample.
#
# The 1024 x 16-bit LUT is loaded separately through bitscrambler_load_lut():
#   L0..L5   phase6 from coarse I5/Q5
#   L8..L13  (32 - phase6) modulo 64
#
# Counter B low six bits implement modulo-64 phase subtraction:
#   B = 32 - previous_phase
#   B += current_phase
#   output B0..B5 = 32 + current_phase - previous_phase
#
# Address bits remain in O22..O31 while counter operations use O16..O23.
# O22/O23 can alter counter bits 6/7, but low-six-bit modulo arithmetic is
# unaffected; only B0..B5 are emitted.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 0
cfg lut_width_bits 16

init:
    LDCTDBL 32

sample_address:
    set 22..26 5..9,
    set 27..31 15..19,
    read 32,
    jmp phase_add

phase_add:
    set 16..21 L0..L5,
    set 22..31 O22..O31,
    read 32,
    ADDCTIBL

emit_and_remember:
    set 0..5 B0..B5,
    set 16..21 L8..L13,
    set 22..31 O22..O31,
    read 32,
    write 8,
    LDCTIBL

decimate_fourth:
    read 32,
    jmp sample_address
