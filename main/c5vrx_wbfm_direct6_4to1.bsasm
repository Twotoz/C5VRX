# SPDX-License-Identifier: GPL-3.0-only

# Packed C5 IQ -> six-bit biased phase delta for direct PARLIO output.
# Four 32-bit IQ words produce one eight-bit PARLIO item.  Only O0..O5 are
# driven; they carry the high six bits of the eight-bit discriminator so the
# existing six-resistor DAC sees code 32 at zero deviation.

cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 0
cfg lut_width_bits 16

init:
    LDCTDBL 128

sample_address:
    set 22..26 5..9,
    set 27..31 15..19,
    read 32,
    jmp phase_add

phase_add:
    set 0..7 L8..L15,
    set 16..23 L0..L7,
    read 32,
    ADDCTIBL

emit_and_remember:
    set 0..5 B2..B7,
    set 16..23 O0..O7,
    read 32,
    write 8,
    LDCTIBL

decimate_fourth:
    read 32,
    jmp sample_address
