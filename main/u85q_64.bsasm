# C5VRX by Twotoz/contributors: 64-state ("Deep Phase") shared-word LUT16 decoder/tracker.
# 64 states (bits 6..11, O26..O31), 16 tokens (bits 12..15, L12..L15), 6-bit DAC (bits 0..5, L0..L5).
cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16
lut 0
controller_0:
    set 0..5 L0..L5,
    set 8..13 L0..L5,
    set 14..15 L12..L13,
    set 16 4,
    set 17 5,
    set 18 6,
    set 19 7,
    set 20 0,
    set 21 1,
    set 22 2,
    set 23 3,
    set 24 15,
    set 25 11,
    set 26..31 L6..L11,
    read 16,
    write 16,
    nop
worker_0:
    set 16..19 L12..L15,
    set 20..25 O26..O31,
    nop
controller_1:
    set 0..5 L0..L5,
    set 8..13 L0..L5,
    set 14..15 L12..L13,
    set 16 4,
    set 17 5,
    set 18 6,
    set 19 7,
    set 20 0,
    set 21 1,
    set 22 2,
    set 23 3,
    set 24 15,
    set 25 11,
    set 26..31 L6..L11,
    read 16,
    write 16,
    nop
worker_1:
    set 16..19 L12..L15,
    set 20..25 O26..O31,
    nop
controller_2:
    set 0..5 L0..L5,
    set 8..13 L0..L5,
    set 14..15 L12..L13,
    set 16 4,
    set 17 5,
    set 18 6,
    set 19 7,
    set 20 0,
    set 21 1,
    set 22 2,
    set 23 3,
    set 24 15,
    set 25 11,
    set 26..31 L6..L11,
    read 16,
    write 16,
    nop
worker_2:
    set 16..19 L12..L15,
    set 20..25 O26..O31,
    nop
controller_3:
    set 0..5 L0..L5,
    set 8..13 L0..L5,
    set 14..15 L12..L13,
    set 16 4,
    set 17 5,
    set 18 6,
    set 19 7,
    set 20 0,
    set 21 1,
    set 22 2,
    set 23 3,
    set 24 15,
    set 25 11,
    set 26..31 L6..L11,
    read 16,
    write 16,
    nop
worker_3:
    set 16..19 L12..L15,
    set 20..25 O26..O31,
    nop
