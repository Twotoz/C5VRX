controller_0:
    # Previous pair result; address this pair's first raw IQ endpoint.
    set 0..5 L0..L5,
    set 8..13 L0..L5,
    set 16..23 0..7,
    set 24..26 H,
    read 16,
    write 16,
    nop
worker_0:
    # Index = previous28 * 64 + current56. B[5:0] retains current56.
    set 16..21 L0..L5,
    set 22..26 B1..B5,
    ldctib

