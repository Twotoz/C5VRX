# Reproducible stacked build: conservative C5 rev1 startup plus live
# RF-to-CVBS path with Sync-Protected Golden Phase5 core.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHFREQ="40m"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
# CONFIG_ESP_ENABLE_PVT is not set
# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240 is not set
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160
CONFIG_C5VRX2_MODE_LIVE=y
# CONFIG_C5VRX2_WBFM_PHASE5_QUALITY is not set
CONFIG_C5VRX2_WBFM_PHASE5_SYNCLOCK=y
# CONFIG_C5VRX2_PARLIO_RX_NEG_EDGE is not set
CONFIG_C5VRX2_PARLIO_RX_CLOCK_INTERNAL=y
# CONFIG_C5VRX2_PARLIO_RX_CLOCK_PLL_F40 is not set
# CONFIG_C5VRX2_PARLIO_RX_CLOCK_MODEM_DEBUG40 is not set
